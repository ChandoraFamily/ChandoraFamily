{
  "name": "lineage-app",
  "version": "0.1.0",
  "private": true,
  "description": "Genealogy app with an interactive pedigree/family-tree graph, person search, and a JSON-backed REST API. Ships as a web app, and wraps into Android (Capacitor) and Windows (Electron) builds.",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on http://localhost:3000 && electron electron/main.js\"",
    "electron:build": "next build && electron-builder --config electron/electron-builder.yml",
    "cap:sync": "next build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/clipboard": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.46.0",
    "mongoose": "^9.10.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.0",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.21.0",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "allowScripts": {
    "electron@44.3.0": true
  }
}
